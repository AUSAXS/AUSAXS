# The AdaptiveCpp every GPU backend is built against, shared so the platforms cannot drift apart. Loaded into each build job's
# environment by .github/actions/gpu-backend-setup, and part of every package's key: changing it rebuilds them all.
# Plain NAME=value lines; no quotes, since $GITHUB_ENV would keep them as part of the value.
ACPP_REPO=https://github.com/AdaptiveCpp/AdaptiveCpp
ACPP_COMMIT=d2272b04
